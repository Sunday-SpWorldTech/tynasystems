{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "backend/private-views/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/assets/images/uploads/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/dev",
      "destination": "/api/index"
    },
    {
      "source": "/dev-login",
      "destination": "/api/index"
    },
    {
      "source": "/dev-dashboard",
      "destination": "/api/index"
    },
    {
      "source": "/dev.html",
      "destination": "/api/index"
    },
    {
      "source": "/dev-login.html",
      "destination": "/api/index"
    },
    {
      "source": "/dev-dashboard.html",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/admin-dashboard",
      "destination": "/admin.html"
    },
    {
      "source": "/staff-dashboard",
      "destination": "/admin.html"
    },
    {
      "source": "/join-free",
      "destination": "/joinfree.html"
    },
    {
      "source": "/coding-academy",
      "destination": "/tyna-coding-academy.html"
    },
    {
      "source": "/internship-opportunity",
      "destination": "/internships.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/settings",
      "destination": "/settings.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    }
  ]
}
